{
  "manifest_version": 3,
  "name": "TWILIGHT Discord Toolkit — Ultimate Edition",
  "short_name": "TWILIGHT",
  "version": "5.1.0",
  "description": "TWILIGHT Discord companion with persistent TERROR Settings, themes, backgrounds, sounds and visible chat discovery.",
  "action": {"default_title": "Open TWILIGHT Ultimate"},
  "permissions": ["storage", "tabs", "windows", "unlimitedStorage"],
  "host_permissions": ["https://discord.com/*", "https://discordapp.com/*"],
  "content_scripts": [{"matches": ["https://discord.com/*", "https://discordapp.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "background": {"service_worker": "background.js"},
  "options_ui": {"page": "settings.html", "open_in_tab": true}
}