{
  "manifest_version": 3,
  "name": "TWILIGHT Discord Toolkit",
  "version": "1.0.0",
  "description": "A safe Discord companion dashboard with search, notes, server tools and analytics.",
  "action": {"default_title": "TWILIGHT Discord Toolkit", "default_popup": "popup.html"},
  "permissions": ["storage"],
  "host_permissions": ["https://discord.com/*"],
  "content_scripts": [{"matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "background": {"service_worker": "background.js"}
}